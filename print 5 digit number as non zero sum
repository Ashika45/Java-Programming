import java.util.*;

class Main {
    public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);
        System.out.println("Enter  number : ");
        int n=sc.nextInt();
        int sum=0;
             
        for(int i=1;i<=5;i++)
            {
               int digit=n%10;
                n=n/10;
            
                if(digit==0)
                {
                    continue;
                }
                 sum=sum+digit;
            }
        
    System.out.println("sum is : "+sum);
    }
}
