import java.util.Scanner;

class Main {
    public static void main(String[] args) {
       Scanner sc = new Scanner(System.in);
        System.out.println("Enter number : ");
         int n=sc.nextInt();

        int num=1;
        while(num<=n)
            {
                System.out.println(num+" ");
                num=(num*2)+1;
            }
    }
}
