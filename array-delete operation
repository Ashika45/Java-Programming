            {
                arr[i]=arr[i+1];
            }
        size--;
        System.out.println("3. Delete at the index : ");
        printActive(arr,size);
      

        // Delete by the value 

        int target=20;
        int foundIndex=-1;

       
        for(int i=0;i<size-1;i++)
            {
            arr[i]=target;
            foundIndex=0;
            break;
            }
        
                if(foundIndex!=-1)
                {
                    for(int i=foundIndex;i<size-1;i++)
