import java.util.*;

class Main {
    public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);
        System.out.println("Enter 5 number : ");
         int sum=0;
             
        for(int i=1;i<=5;i++)
            {
                int num=sc.nextInt();
                sum+=i;

                if(num==0)
                {
                    continue;
                }
            }
    System.out.println("sum is : "+sum);
    }
}
