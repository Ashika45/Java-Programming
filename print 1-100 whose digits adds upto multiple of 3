import java.util.Scanner;

class Main {
    public static void main(String[] args) {
       // Scanner sc = new Scanner(System.in);
      //  System.out.println("Enter number of rows: ");
        for(int i=1;i<=100;i++)
            {
                int temp=i;
                int digitsum=0;

              while(temp>0)
                  {
                      int digit=temp%10;
                      digitsum+=digit;
                      temp/=10;
                  }
            if(digitsum%3==0)
            {
                System.out.println(i+ " ");
            }
            }
    }
}
