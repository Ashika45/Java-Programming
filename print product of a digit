import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the number : ");
        int n=sc.nextInt();
        int prod=1,rem;
        for(int i=1;i<=n;i++)
            {
                rem=n%10;
                prod=prod*rem;
                n=n/10;
                
            }
        System.out.println(prod);
            
    }
}
