import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter n: ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++) {
            
            System.out.println("multiplication of " + i+"*"+i +"is :"+(i*i));
        }

        sc.close();
    }
}
