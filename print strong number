import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter num  : ");
        int num=sc.nextInt();
        
        if(num<=0)
        {
            System.out.println("Not a Strong number");
        }
        else
        {
            int temp=num;
            int sum=0,rev;

            while(temp>0)
                {
                    int fact=1;
                    rev=temp%10;
                    
                    for(int i=1;i<=rev;i++)
                    {
                        fact=fact*i;
                    }
                    sum=sum+fact;
                    temp=temp/10;
                    
                }
            if(sum==num)
            {
                System.out.println("strong number");
            }
            else
            {
                 System.out.println("not a strong number");
            }
        }
    }
}
