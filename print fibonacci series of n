import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the terms : ");
        int terms=sc.nextInt();
        int first=0;
        int second=1,next;
        
        System.out.println("Series : ");
        for(int i=1;i<=terms;i++)
            {
                System.out.println(first + " ");
                next = first + second;
                first = second;
                second = next;
            }
    }
}
